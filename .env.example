# ECHO//AFTER Server Environment Variables
PORT=3001

# Gemma / AI Configuration
# Optional: Set your Google Gemma 4 or Gemini API key to enable live model inference.
# If omitted, ECHO//AFTER runs in fully featured offline DEMO MODE with deterministic paranormal responses.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4

# Alternative OpenAI-compatible Gemma endpoint (e.g. Ollama, OpenRouter, vLLM)
# GEMMA_BASE_URL=https://openrouter.ai/api/v1
# GEMMA_BASE_URL=http://localhost:11434/v1
